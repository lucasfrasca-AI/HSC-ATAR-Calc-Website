{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/node_modules/**", "**/.DS_Store"],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-uDHPohARmwQHeZESTKHLCscwbuszIqHuzDNsYVMRBVY='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "regex": "^/assets/.*",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "regex": "^/(?!assets/).*",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
